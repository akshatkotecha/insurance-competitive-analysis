{
  "name": "Insurance Financial Terminal — Light",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "backgroundLight": "#f7f8fa",
  "backgroundNeutral": "#eef1f6",
  "tableAccent": "#1B3A6B",
  "good": "#0ca30c",
  "neutral": "#8a8a8a",
  "bad": "#d03b3b",
  "maximum": "#d03b3b",
  "center": "#8a8a8a",
  "minimum": "#0ca30c",
  "null": "#c3c2b7",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#0b0b0b"
    },
    "title": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#ffffff"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#0b0b0b"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#0b0b0b"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "background": {
              "solid": {
                "color": "#1B3A6B"
              }
            },
            "bold": true,
            "fontSize": 10,
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#d9dde3"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": "#0b0b0b",
            "fontSize": 22
          }
        ],
        "categoryLabels": [
          {
            "color": "#52514e",
            "fontSize": 9
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": "#0b0b0b",
            "background": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 2
          }
        ],
        "columnHeaders": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#eef1f6"
              }
            },
            "fontColor": "#0b0b0b",
            "bold": true,
            "fontSize": 10
          }
        ],
        "values": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "fontColor": "#0b0b0b",
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "rowPadding": 2
          }
        ],
        "columnHeaders": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#eef1f6"
              }
            },
            "fontColor": "#0b0b0b",
            "bold": true,
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": "#0b0b0b",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9
          }
        ]
      }
    }
  }
}