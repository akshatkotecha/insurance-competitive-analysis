	measure 'Market Share Label' = IF(ISBLANK([Market Share]), "not disclosed", FORMAT([Market Share], "0.0") & "%")
		lineageTag: 4b8d2f6a-9c1e-4a7d-b3f5-6e9c2a8d4f1b

	measure 'ROE Label' = IF(ISBLANK([ROE Pct]), "not disclosed", FORMAT([ROE Pct], "0.0"))
