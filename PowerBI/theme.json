{
  "name": "Insurance Financial Terminal — Light",
  "dataColors": [
    "#1B3A6B",
    "#9AA5B1",
    "#9AA5B1",
    "#9AA5B1",
    "#9AA5B1",
    "#9AA5B1",
    "#9AA5B1",
    "#9AA5B1"
  ],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#6B6B6B",
  "backgroundLight": "#f7f9fc",
  "backgroundNeutral": "#EAEFF7",
  "tableAccent": "#1B3A6B",
  "good": "#0ca30c",
  "neutral": "#8a8a8a",
  "bad": "#d03b3b",
  "maximum": "#d03b3b",
  "center": "#8a8a8a",
  "minimum": "#0ca30c",
  "null": "#c3c2b7",
  "textClasses": {
    "callout": { "fontSize": 22, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "title": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#ffffff" },
    "header": { "fontSize": 10, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#ffffff" } },
            "background": { "solid": { "color": "#1B3A6B" } },
            "bold": true,
            "fontSize": 11,
            "alignment": "left"
          }
        ],
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D9D9D9" } } }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 4, "bottom": 4, "left": 8, "right": 8 }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#ffffff" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": "#1B3A6B", "fontSize": 22 }],
        "categoryLabels": [{ "color": "#52514e", "fontSize": 9 }]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [{ "backgroundColor": { "solid": { "color": "#ffffff" } } }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } } }],
        "items": [{ "fontColor": "#0b0b0b", "background": { "solid": { "color": "#ffffff" } }, "fontSize": 9 }],
        "data": [{ "mode": "Dropdown" }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "rowPadding": 6, "textSize": 9 }],
        "columnHeaders": [{ "backgroundColor": { "solid": { "color": "#EAEFF7" } }, "fontColor": "#0b0b0b", "bold": true, "fontSize": 10 }],
        "values": [
          {
            "backColorPrimary": { "solid": { "color": "#ffffff" } },
            "backColorSecondary": { "solid": { "color": "#F7F9FC" } },
            "fontColor": "#0b0b0b",
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "rowPadding": 6, "textSize": 9 }],
        "columnHeaders": [{ "backgroundColor": { "solid": { "color": "#EAEFF7" } }, "fontColor": "#0b0b0b", "bold": true, "fontSize": 10 }],
        "rowHeaders": [{ "fontColor": "#0b0b0b", "fontSize": 9 }],
        "values": [{ "fontSize": 9 }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 1.5 }]
      }
    }
  }
}
